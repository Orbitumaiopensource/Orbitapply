# ─── Required ─────────────────────────────────────────────────────────────────
# At least ONE search provider key is required.
# OrbitApply will automatically use whichever providers have keys configured,
# falling back through the list in priority order.

# ─── AI (Required for resume tailoring, company intel, interview prep) ─────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Search Providers (add one or more) ───────────────────────────────────────
# Priority order: Tavily → Brave → SerpAPI → Bing → Google → Jina → DuckDuckGo
# DuckDuckGo requires no key and is always available as final fallback.

# 1. Tavily — paid, highest quality (recommended)
# Sign up: https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# 2. Brave Search — 2000 free searches/month
# Sign up: https://api.search.brave.com
BRAVE_API_KEY=

# 3. SerpAPI — 100 free searches/month
# Sign up: https://serpapi.com
SERPAPI_KEY=

# 4. Bing Search API — 1000 free searches/month
# Sign up: https://portal.azure.com (Bing Search v7)
BING_SEARCH_KEY=

# 5. Google Custom Search — 100 free searches/day
# Sign up: https://programmablesearchengine.google.com
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# 6. Jina AI Reader — free tier available
# Sign up: https://jina.ai (optional — works without key at lower rate limit)
JINA_API_KEY=

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
