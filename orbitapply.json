{
  "budget": {
    "dailyLimitUSD": 5,
    "alertAtUSD": 4,
    "hardStop": true
  },
  "guardian": {
    "maxAppliesPerDay": 15,
    "rateLimitMs": 45000,
    "humanPauseFields": [
      "salary",
      "diversity",
      "custom_essay",
      "security_clearance",
      "disability",
      "gender",
      "race",
      "ethnicity",
      "veteran",
      "signature",
      "certify",
      "attestation"
    ]
  },
  "outputFolder": "./Apply",
  "agents": {
    "defaults": {
      "model": "claude-haiku-4-5-20251001",
      "subagents": {
        "maxDepth": 2,
        "maxConcurrent": 4
      }
    },
    "overrides": {
      "orbi": {
        "model": "claude-sonnet-4-20250514"
      },
      "tailor": {
        "model": "claude-sonnet-4-20250514"
      },
      "coach": {
        "model": "claude-sonnet-4-20250514"
      }
    }
  },
  "scout": {
    "minDisplayScore": 30,
    "minQualifiedScore": 70,
    "maxQueries": 15,
    "maxResultsPerQuery": 15
  }
}